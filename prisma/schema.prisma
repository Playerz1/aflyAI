generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(MEMBER)
  status       Status   @default(ACTIVE)
  lastLogin    DateTime?
  profilePicture String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  resetTokens PasswordResetToken[]
  sales    Sale[]
  infoproducts Infoproduct[]
}

enum Role {
  ADMIN
  MEMBER
}

enum Status {
  ACTIVE
  SUSPENDED
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Sale {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Infoproduct {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("")
  niche       String   @default("")
  nicheData   Json     @default("{}")
  price       Float?
  format      String?
  description String   @default("")
  currentStep Int      @default(1)
  data        Json     @default("{}")
  pdfUrl      String   @default("")
  modulesData Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productSales ProductSale[]

  @@index([userId, createdAt])
}

model ProductSale {
  id        String   @id @default(cuid())
  productId String
  product   Infoproduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount    Float
  quantity  Int      @default(1)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}
