# Neon PostgreSQL (obrigatório)
# Use a connection string "Pooled" para serverless/Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Opcional: conexão direta para migrations (se Neon fornecer separada)
DIRECT_URL=""

# Auth (obrigatório em produção)
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Ambiente
NODE_ENV="development"
APP_URL="http://localhost:5174"

# Admin seed (opcional - usado por prisma/seed.js)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-on-first-run"
ADMIN_NAME="Administrador"
