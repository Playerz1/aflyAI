{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@5.1.8",
      "includeFiles": "lib/**,prisma/schema.prisma"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/dashboard.html"
    }
  ]
}
